{
  "cleanUrls": true,
  "rewrites": [],
  "redirects": [
    { "source": "/carrinho", "destination": "/cart", "permanent": true },
    { "source": "/carrinho.html", "destination": "/cart", "permanent": true },
    { "source": "/obrigado", "destination": "/thank-you", "permanent": true },
    { "source": "/obrigado.html", "destination": "/thank-you", "permanent": true },
    { "source": "/motorscent", "destination": "/", "permanent": true },
    { "source": "/a/checkout", "destination": "/checkout", "permanent": false },
    { "source": "/collections/(.*)", "destination": "/", "permanent": false },
    { "source": "/products/(.*)", "destination": "/", "permanent": false },
    { "source": "/pages/(.*)", "destination": "/", "permanent": false },
    { "source": "/account/(.*)", "destination": "/", "permanent": false },
    { "source": "/customer_authentication/(.*)", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/motorscent-assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
