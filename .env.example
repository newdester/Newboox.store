# Use credenciais de TESTE primeiro. Nunca envie este arquivo com chaves reais ao Git.
MP_PUBLIC_KEY=TEST-COLE-SUA-CHAVE-PUBLICA
MP_ACCESS_TOKEN=TEST-COLE-SEU-ACCESS-TOKEN
# Configure no painel do Mercado Pago para validar os avisos recebidos.
MP_WEBHOOK_SECRET=TEST-COLE-O-SEGREDO-DO-WEBHOOK
# URL pública HTTPS do site em produção. Necessária para webhooks e retorno de pagamento.
PUBLIC_BASE_URL=https://sua-loja.com.br
# Chave privada para liberar nome, e-mail e telefone no painel /admin.
# Defina o mesmo valor nas variáveis de ambiente da Vercel; ela nunca é enviada ao visitante.
ADMIN_DASHBOARD_TOKEN=crie-uma-chave-longa-e-unica

# Opcional: dados de campanha no painel. Este token é de LEITURA da Meta Ads API,
# diferente do token da Conversions API. Informe a versão atualmente suportada pela Meta.
META_AD_ACCOUNT_ID=act_1234567890
META_ADS_ACCESS_TOKEN=COLE_UM_TOKEN_COM_ads_read_E_read_insights
META_GRAPH_API_VERSION=vXX.0

# Cakto — credenciais do servidor (nunca exponha no HTML/JavaScript público).
CAKTO_CLIENT_ID=COLE_SEU_CLIENT_ID
CAKTO_CLIENT_SECRET=COLE_SEU_CLIENT_SECRET
# Oferta em USD para vendas internacionais e oferta em BRL para compradores no Brasil.
CAKTO_OFFER_ID_USD=COLE_O_ID_DA_OFERTA_USD
CAKTO_OFFER_ID_BRL=COLE_O_ID_DA_OFERTA_BRL
# Segredo gerado/configurado no webhook da Cakto.
CAKTO_WEBHOOK_SECRET=COLE_O_SEGREDO_DO_WEBHOOK
